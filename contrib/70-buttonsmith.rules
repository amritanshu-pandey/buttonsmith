# Buttonsmith: give the logged-in user access to the ProtoArc
# trackball's receiver (and only that device) plus /dev/uinput.
# "uaccess" grants an ACL to the active seat user. The file must sort
# before 73-seat-late.rules.
# Other mice get their own rule in 71-buttonsmith-device.rules, written
# by "Allow access" in the settings window (`buttonsmith allow-device`).
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{id/vendor}=="25a7", ATTRS{id/product}=="fa61", TAG+="uaccess"
KERNEL=="uinput", SUBSYSTEM=="misc", TAG+="uaccess", OPTIONS+="static_node=uinput"
